configuration {
    modi: "drun";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec";
    drun-use-desktop-cache: false;
    drun-reload-desktop-cache: false;
    matching: "normal";
    tokenize: true;
    auto-select: true;
    sort: true;
    sorting-method: "normal";
    case-sensitive: false;
    normalize-match: false;
    cycle: true;
    click-to-exit: true;
    hover-select: true;
}

* {
    font: "JetBrainsMono Nerd Font Medium 10.5";
    bg: #18121a;
    bg-alt: #261522;
    bg-hover: #3d2035;
    fg: #f8e1ec;
    muted: #8c6e80;
    accent: #f5c2e7;
    glow: rgba(245, 194, 231, 0.25);
}

window {
    width: 54%;
    location: center;
    anchor: center;
    background-color: @bg;
    transparency: "real";
    border: 2px;
    border-color: @glow;
    border-radius: 18px;
    cursor: "default";
}

mainbox {
    background-color: transparent;
    padding: 18px;
    spacing: 12px;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: rgba(255, 255, 255, 0.06);
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px;
    border-color: rgba(245, 194, 231, 0.25);
    children: [ entry ];
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search apps...";
    placeholder-color: @muted;
    cursor-color: @accent;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 3;
    lines: 5;
    spacing: 10px;
    scrollbar: false;
    fixed-height: false;
    dynamic: true;
    fixed-columns: true;
}

element {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 10px;
    border-radius: 12px;
    spacing: 10px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.03);
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-hover;
    text-color: @accent;
    border: 2px;
    border-color: @accent;
}

element-icon {
    background-color: transparent;
    size: 28px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold #f5c2e7;
    cursor: inherit;
}

mode-switcher {
    enabled: false;
}
