* {
    font: "Adwaita Sans 11";
    background-color: transparent;
    text-color: #e6d7dc;
    bg: rgba(34, 28, 33, 0.96);
    bg-alt: #2c252b;
    fg: #e6d7dc;
    muted: rgba(230, 215, 220, 0.50);
    accent: #d69aac;
    glow: rgba(69, 57, 63, 0.40);
    selected: #45393f;
    spacing: 0px;
}

window {
    width: 64%;
    location: center;
    anchor: center;
    background-color: @bg;
    transparency: "real";
    border: 1px;
    border-color: @glow;
    border-radius: 24px;
    padding: 0px;
    cursor: default;
}

mainbox {
    padding: 22px;
    spacing: 16px;
    children: [ "inputbar", "message", "listview" ];
}


num-filtered-rows {
    font: "JetBrainsMono Nerd Font 9";
    text-color: @accent;
    background-color: rgba(214, 154, 172, 0.07);
    border-radius: 8px;
    padding: 5px 9px;
    expand: false;
    vertical-align: 0.5;
}

inputbar {
    background-color: #2c252b;
    border: 1px;
    border-color: rgba(214, 154, 172, 0.18);
    border-radius: 14px;
    padding: 14px 16px;
    spacing: 12px;
    children: [ "textbox-search", "entry", "num-filtered-rows" ];
}

textbox-search {
    str: "";
    font: "JetBrainsMono Nerd Font 12";
    text-color: @accent;
    expand: false;
    vertical-align: 0.5;
}

entry {
    text-color: @fg;
    placeholder: "Search applications…";
    placeholder-color: @muted;
    cursor-color: @accent;
    cursor-width: 2px;
    vertical-align: 0.5;
    cursor: text;
}

listview {
    columns: 2;
    lines: 6;
    spacing: 6px;
    scrollbar: false;
    fixed-height: false;
    dynamic: true;
    fixed-columns: true;
}

element {
    background-color: transparent;
    text-color: @fg;
    orientation: horizontal;
    padding: 12px;
    spacing: 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    children: [ "element-icon", "element-text" ];
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @bg-alt;
    text-color: @fg;
}

element selected.normal,
element selected.active {
    background-color: @selected;
    text-color: #e6d7dc;
    border-color: rgba(214, 154, 172, 0.30);
}

element normal.active,
element alternate.active {
    background-color: rgba(214, 154, 172, 0.05);
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    background-color: rgba(217, 115, 127, 0.08);
    text-color: #d9737f;
}

element selected.urgent {
    background-color: rgba(217, 115, 127, 0.14);
    text-color: #e6d7dc;
    border-color: rgba(217, 115, 127, 0.35);
}

element-icon {
    size: 32px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    highlight: bold;
    cursor: inherit;
    expand: true;
}

message {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px;
}

textbox {
    text-color: @fg;
}

scrollbar {
    background-color: transparent;
    handle-color: rgba(214, 154, 172, 0.25);
    handle-width: 3px;
    border-radius: 8px;
}

mode-switcher {
    enabled: false;
}

@media (enabled: DMENU) {
    window {
        width: 58%;
    }
    mainbox {
        padding: 16px;
        spacing: 12px;
        children: [ "inputbar", "message", "listview" ];
    }
    inputbar {
        padding: 12px 14px;
        children: [ "textbox-search", "entry" ];
    }
    entry {
        placeholder: "Search…";
    }
    listview {
        columns: 1;
        lines: 12;
    }
    element {
        padding: 8px 12px;
        border-radius: 10px;
        children: [ "element-text" ];
    }
}
