configuration {
    modi: "drun";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec";
    drun-use-desktop-cache: false;
    drun-reload-desktop-cache: false;
    matching: "normal";
    tokenize: true;
    auto-select: true;
    sort: true;
    sorting-method: "normal";
    case-sensitive: false;
    normalize-match: false;
    cycle: true;
    click-to-exit: true;
    hover-select: true;
}

@theme "design.rasi"
